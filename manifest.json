{
  "manifest_version": 3,
  "name": "Doomn't",
  "version": "2.19.0",
  "description": "不再無限滑：隱藏 YouTube Shorts 與推薦影片、Instagram Reels / 探索 / 建議貼文，只留下你自己選擇要看的內容；4chan 擋掉成人看板。",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "css": [
        "youtube/style.css"
      ],
      "js": [
        "youtube/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "css": [
        "instagram/style.css"
      ],
      "js": [
        "instagram/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://4chan.org/*",
        "https://*.4chan.org/*",
        "https://*.4channel.org/*"
      ],
      "css": [
        "fourchan/style.css"
      ],
      "js": [
        "fourchan/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "images/poster-1.png",
        "images/poster-2.png",
        "images/poster-3.png",
        "images/poster-4.png",
        "images/poster-5.png",
        "images/poster-6.png",
        "images/poster-7.png",
        "images/poster-8.png"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.instagram.com/*"
      ]
    }
  ]
}
